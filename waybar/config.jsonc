{
  "layer": "top",
  "position": "top",
  "height": 30,
  "modules-left": [
    "sway/workspaces"
  ],
  "modules-center": [
    "tray"
  ],
  "modules-right": [
    "cpu",
    "memory",
    "network",
    "pulseaudio",
    "battery",
    "backlight",
    "clock",
    "custom/power"
  ],
  "custom/separator": {
    "format": "  |  ",
    "tooltip": false
  },
  "custom/power": {
    "format": "⏻",
    "on-click": "wlogout",
    "tooltip": "Power Menu"
  },
  "clock": {
    "format": "{:%a %d %b %H:%M}",
    "tooltip-format": "{:%Y-%m-%d %H:%M:%S}"
  },
  "cpu": {
    "interval": 5,
    "format": "  {usage}%",
    "tooltip": "CPU"
  },
  "memory": {
    "interval": 5,
    "format": "󰍛  {}%",
    "tooltip": "Memory"
  },
  "network": {
    "interval": 3,
    "format": "󰤨  {ifname}: {essid}",
    "tooltip": "{ipaddr} {signalStrength}%",
    "on-click": "nm-connection-editor"
  },
  "pulseaudio": {
    "format": "{icon} {volume}%",
    "format-muted": " muted",
    "format-icons": {
      "default": ["", ""], // Font Awesome 6 or Nerd Font speaker icons
      "muted": ""
    },
    "tooltip": false,
    "on-click": "pavucontrol"
  },
  "battery": {
    "interval": 10,
    "format": "{icon}  {capacity}%",
    "format-icons": [ "", "", "", "", "" ],
    "format-charging": "  {capacity}%",
    "tooltip": "Battery"
  },
  "backlight": {
    "format": " {percent}%",
    "tooltip": "Backlight",
    "format-icons": ["", ""],
    "on-scroll-up": "brightnessctl -c backlight set +5%",
    "on-scroll-down": "brightnessctl -c backlight set 5%-"
  },
  "tray": {
    "icon-size": 18,
    "spacing": 8
  }
}
