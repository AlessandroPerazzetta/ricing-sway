# IT Keyboard layout
input 1:1:AT_Translated_Set_2_keyboard xkb_layout it

# Disable Thinkpad Touchpad
input 2:7:SynPS/2_Synaptics_TouchPad events disabled

# Thinkpad keys
## Volume
bindsym --locked XF86AudioRaiseVolume exec pactl set-sink-volume @DEFAULT_SINK@ +5%
bindsym --locked XF86AudioLowerVolume exec pactl set-sink-volume @DEFAULT_SINK@ -5%
bindsym --locked XF86AudioMute exec pactl set-sink-mute @DEFAULT_SINK@ toggle
## Mic
bindsym --locked XF86AudioMicMute exec pactl set-source-mute @DEFAULT_SOURCE@ toggle
## Pavucontrol
bindsym $mod+Shift+v exec pavucontrol

## Thinkvantage Button = Terminal
bindsym XF86Launch1 exec $term
## Brightness - Uses MOD key because fn won't work
bindsym $mod+Home exec brightnessctl set 10%+
bindsym $mod+End exec brightnessctl set 10%-

bindsym --locked XF86MonBrightnessUp exec brightnessctl set 10%+
bindsym --locked XF86MonBrightnessDown exec brightnessctl set 10%-

## Printscreen
bindsym	Print exec grim

include @sysconfdir@/sway/config.d/*
