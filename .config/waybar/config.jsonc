{
  "layer": "top",
  "position": "top",
  "height": 30,
  "modules-left": [
    "sway/workspaces"
  ],
  "modules-center": [
    "tray"
  ],
  "modules-right": [
    "cpu",
    "memory",
    "custom/temps",
    //"temperature#CPU",
    //"temperature#GPU",
    //"custom/fan_tmp",
    "network",
    "pulseaudio",
    "battery",
    "backlight",
    "clock",
    "custom/power"
  ],
  "custom/separator": {
    "format": "  |  ",
    "tooltip": false
  },
  "custom/power": {
    "format": "⏻",
    "on-click": "wlogout",
    "tooltip": "Power Menu"
  },
  "clock": {
    "format": "{:%a %d %b %H:%M}",
    "tooltip-format": "{:%Y-%m-%d %H:%M:%S}"
  },
  "cpu": {
    "interval": 5,
    "format": "  {usage}%",
    "tooltip": "CPU"
  },
  "memory": {
    "interval": 5,
    "format": "󰍛  {}%",
    "tooltip": "Memory"
  },
  // To get right hwmon-path lm_sensors is required and can retrieved with this command:
  // for i in /sys/class/hwmon/hwmon*/temp*_input; do echo "$(<$(dirname $i)/name): $(cat ${i%_input}_label 2>/dev/null || echo $(basename ${i%_input})) $(readlink -f $i)"; done
  /*
  "temperature#CPU": {
    "interval": 10,
    "hwmon-path": "/sys/devices/platform/thinkpad_hwmon/hwmon/hwmon3/temp1_input",
    "format": " {temperatureC}°C",
    "format-icons": ["", "", "", ""],
    "critical-threshold": 80,
    "tooltip": true,
    "tooltip-format": "CPU: {temperatureC}°C"
  },
  "temperature#GPU": {
    "interval": 10,
    "hwmon-path": "/sys/devices/platform/thinkpad_hwmon/hwmon/hwmon3/temp2_input",
    "format": " {temperatureC}°C",
    "format-icons": ["", "", "", ""],
    "critical-threshold": 80,
    "tooltip": true
  },
  */
  "custom/temps": {
    "interval": 5,
    "exec": "~/.config/waybar/scripts/thinkpad_temps.sh",
    "critical-threshold": 80,
    "tooltip": true,
    "return-type": "json"
  },
  "custom/fan_tmp": {
    "interval": 5,
    "exec": "~/.config/waybar/scripts/thinkpad_fan_tmp.sh",
    "tooltip": " CPU Temp & Fan"
  },
  "network": {
    "interval": 3,
    "format": "󰤨  {ifname}: {essid}",
    "tooltip": "{ipaddr} {signalStrength}%",
    "on-click": "nm-connection-editor"
  },
  "pulseaudio": {
    "format": "{icon} {volume}%",
    "format-muted": " muted",
    "format-icons": {
      "default": ["", ""], // Font Awesome 6 or Nerd Font speaker icons
      "muted": ""
    },
    "tooltip": false,
    "on-click": "pavucontrol"
  },
  "battery": {
    "interval": 10,
    "format": "{icon}  {capacity}%",
    //"format-icons": [ "", "", "", "", "" ],
    "format-icons": [ "", "", "", "", "" ],
    "format-charging": "  {capacity}%",
    "tooltip": "Battery"
  },
  "backlight": {
    "format": " {percent}%",
    "tooltip": "Backlight",
    "format-icons": ["", ""],
    "on-scroll-up": "brightnessctl -c backlight set +5%",
    "on-scroll-down": "brightnessctl -c backlight set 5%-"
  },
  "tray": {
    "icon-size": 18,
    "spacing": 8
  }
}
